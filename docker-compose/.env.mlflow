# Local-dev defaults for the MLflow Compose stack — NOT secrets.
# In the cloud these come from env vars / Secret Manager; never reuse these values there.

# Postgres backend store (model registry requires a DB backend)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
PGPORT=5432

# RustFS S3 credentials (used as AWS_* by MLflow, the bucket creator, and RustFS itself)
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_DEFAULT_REGION=us-east-1
RUSTFS_CONSOLE_ENABLE=true
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=mlflow

# MLflow server
MLFLOW_PORT=5000
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${PGPORT}/${POSTGRES_DB}
MLFLOW_ARTIFACTS_DESTINATION=s3://${S3_BUCKET}
MLFLOW_S3_ENDPOINT_URL=http://storage:${S3_API_PORT}
