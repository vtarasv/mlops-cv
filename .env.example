# Precedence (lowest first): .env  <  OS environment.
ENV=local   # environment identifier (local|dev|stage|prod)
LOG_LEVEL=DEBUG

DATA__RAW_DIR=/abs/path/to/VisDrone-VID
DATA__SUBSET_DIR=/abs/path/to/subset

MLFLOW__TRACKING_URI=http://localhost:5000

TRAINING__EPOCHS=30
TRAINING__IMGSZ=640
TRAINING__WEIGHTS=/abs/path/to/weights/yolo26s.pt
