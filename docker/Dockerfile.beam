# CPU data-prep image for the CT DAG's DockerOperator tasks: the Beam ingestion
# (raw -> subset + demo store) and dataset-profiling pipelines (DirectRunner).
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /uvx /bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

COPY .python-version pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --group beam --no-install-project

COPY README.md ./
COPY src/ src/
COPY configs/ configs/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --group beam

# Beam's local runner (Prism) downloads a Go service binary on first use.
RUN /app/.venv/bin/python -c "import apache_beam as beam; p = beam.Pipeline(); \
_ = p | beam.Create([1]); p.run().wait_until_finish()"

ENV PATH="/app/.venv/bin:$PATH"
