{
  "uid": "streaming",
  "title": "Streaming — Redpanda broker",
  "tags": ["mlops-cv"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Broker up",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [{ "refId": "A", "expr": "up{job=\"redpanda\"}", "legendFormat": "broker" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unavailable partitions",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(redpanda_cluster_unavailable_partitions) or vector(0)",
          "legendFormat": "unavailable"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Max consumer-group lag",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max(redpanda_kafka_consumer_group_lag_max) or vector(0)",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Consumer-group lag (max per group)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "redpanda_kafka_consumer_group_lag_max",
          "legendFormat": "{{redpanda_group}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Consumer-group lag (sum over partitions)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "redpanda_kafka_consumer_group_lag_sum",
          "legendFormat": "{{redpanda_group}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kafka throughput by direction",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (redpanda_request) (rate(redpanda_kafka_request_bytes_total[1m]))",
          "legendFormat": "{{redpanda_request}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Committed offsets by group and topic",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (redpanda_group, redpanda_topic) (redpanda_kafka_consumer_group_committed_offset)",
          "legendFormat": "{{redpanda_group}} / {{redpanda_topic}}"
        }
      ]
    }
  ]
}
