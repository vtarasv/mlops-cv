# GPU train/eval image for the CT DAG's DockerOperator tasks.
FROM nvidia/cuda:13.2.0-cudnn-devel-ubuntu24.04

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /uvx /bin/

# ultralytics' transitive opencv-python needs the GUI/GL runtime libs the CUDA base doesn't ship
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libxcb1 \
    && rm -rf /var/lib/apt/lists/*

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python

WORKDIR /app

COPY .python-version pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-group dev --no-group airflow --no-install-project

COPY README.md ./
COPY src/ src/
COPY configs/ configs/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-group dev --no-group airflow

ENV PATH="/app/.venv/bin:$PATH"
