# The drift monitor: live frames off the bus scored against the champion's drift baseline.

# The deps layers key on their groups' export, not on the raw pyproject.toml/uv.lock: an edit
# that leaves a group's resolved set alone (tool config, another group) keeps its layer cached.
FROM ghcr.io/astral-sh/uv:0.11.26 AS lock
WORKDIR /lock
COPY pyproject.toml uv.lock ./
RUN ["/uv", "export", "--frozen", "--no-default-groups", "--group", "monitoring", "--no-emit-project", "--format", "pylock.toml", "-o", "pylock.monitoring.toml"]

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /uvx /bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

COPY .python-version ./
COPY --from=lock /lock/pylock.monitoring.toml ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv && uv pip sync pylock.monitoring.toml

COPY pyproject.toml uv.lock README.md ./
COPY src/ src/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --group monitoring

ENV PATH="/app/.venv/bin:$PATH"

# Non-root, with a HOME the tracking client can use for its artifact downloads.
RUN useradd --create-home --uid 1000 monitor
ENV HOME=/home/monitor
USER monitor

CMD ["python", "-m", "mlops_cv.monitoring"]
