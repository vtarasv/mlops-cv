# Local-dev defaults for the streaming Compose stack.
# These are NOT secrets (throwaway local credentials/keys); in cloud they come from a secret manager.

# Host-facing external Kafka listener (in-network clients use redpanda:9092).
# Host-side clients dial the port in StreamingSettings.bootstrap_servers; tests/unit/test_stack_constants.py pins the pair.
KAFKA_HOST_PORT=19092
# Redpanda Console UI on the host (8080 belongs to Airflow).
CONSOLE_HOST_PORT=8085

# Topic layout (names and the frame cap pinned against Python by tests/unit/test_stack_constants.py).
RAW_FRAMES_TOPIC=raw-frames
DETECTIONS_TOPIC=detections
ALERTS_TOPIC=alerts
# raw-frames + detections partitions (keyed by sequence -> per-clip ordering holds).
DATA_TOPIC_PARTITIONS=3
# Per-topic cap for frame messages (bytes).
FRAME_MAX_MESSAGE_BYTES=4194304
# raw-frames retention (ms). Frames are bulky, ephemeral transport — 1 h.
FRAME_RETENTION_MS=3600000
