# CPU data-prep image for the CT DAG's DockerOperator tasks: the Beam ingestion
# (raw -> subset + demo store) and dataset-profiling pipelines (DirectRunner).

# The deps layers key on their groups' export, not on the raw pyproject.toml/uv.lock: an edit
# that leaves a group's resolved set alone (tool config, another group) keeps its layer cached.
FROM ghcr.io/astral-sh/uv:0.11.26 AS lock
WORKDIR /lock
COPY pyproject.toml uv.lock ./
RUN ["/uv", "export", "--frozen", "--no-default-groups", "--group", "beam", "--no-emit-project", "--format", "pylock.toml", "-o", "pylock.beam.toml"]

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /uvx /bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

WORKDIR /app

COPY .python-version ./
COPY --from=lock /lock/pylock.beam.toml ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv && uv pip sync pylock.beam.toml

COPY pyproject.toml uv.lock README.md ./
COPY src/ src/
COPY configs/ configs/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --group beam

# The DAG runs this as the host uid: any uid gets a HOME, and a USER so getpass skips passwd.
RUN mkdir -m 1777 /home/app
ENV HOME=/home/app USER=app

# Beam's local runner (Prism) downloads a Go service binary on first use; any uid must exec it.
RUN /app/.venv/bin/python -c "import apache_beam as beam; p = beam.Pipeline(); \
_ = p | beam.Create([1]); p.run().wait_until_finish()" \
    && chmod -R a+rX "$HOME/.apache_beam"

ENV PATH="/app/.venv/bin:$PATH"
