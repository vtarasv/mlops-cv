{
  "uid": "gpu",
  "title": "GPU — DCGM",
  "tags": [
    "mlops-cv"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "GPU utilization",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu) (DCGM_FI_DEV_GPU_UTIL)",
          "legendFormat": "{{gpu}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "VRAM used",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "min": 0,
          "max": 8192,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5734
              },
              {
                "color": "red",
                "value": 7373
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu) (DCGM_FI_DEV_FB_USED)",
          "legendFormat": "{{gpu}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Temperature",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu) (DCGM_FI_DEV_GPU_TEMP)",
          "legendFormat": "{{gpu}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Power draw",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu) (DCGM_FI_DEV_POWER_USAGE)",
          "legendFormat": "{{gpu}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU utilization over time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu) (DCGM_FI_DEV_GPU_UTIL)",
          "legendFormat": "{{gpu}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "VRAM used / free",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu) (DCGM_FI_DEV_FB_USED)",
          "legendFormat": "used {{gpu}}"
        },
        {
          "refId": "B",
          "expr": "max by (gpu) (DCGM_FI_DEV_FB_FREE)",
          "legendFormat": "free {{gpu}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Temperature over time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu) (DCGM_FI_DEV_GPU_TEMP)",
          "legendFormat": "{{gpu}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Power draw over time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (gpu) (DCGM_FI_DEV_POWER_USAGE)",
          "legendFormat": "{{gpu}}"
        }
      ]
    }
  ]
}