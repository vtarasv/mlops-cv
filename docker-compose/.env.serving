# Local-dev defaults for the serving Compose stack.
# These are NOT secrets (throwaway local credentials/keys); in cloud they come from a secret manager.

# Port the service listens on inside the container: passed to the app as SERVING__PORT.
SERVING_PORT=8000
# Host-facing port.
SERVING_HOST_PORT=8000

# The MLflow stack's server port (the tracking URI inside the network is http://mlflow:<port>).
MLFLOW_PORT=5000

# Observability UIs on the host.
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
