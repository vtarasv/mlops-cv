# The two training-stack images, one file, two targets (`docker build --target train|optimize`):
#   train    — train/eval for the CT DAG's DockerOperator tasks (training group)
#   optimize — graph export, ahead-of-time compilation, benchmarking (training + optimize groups)

# The deps layers key on their groups' export, not on the raw pyproject.toml/uv.lock: an edit
# that leaves a group's resolved set alone (tool config, another group) keeps its layer cached.
FROM ghcr.io/astral-sh/uv:0.11.26 AS lock
WORKDIR /lock
COPY pyproject.toml uv.lock ./
RUN ["/uv", "export", "--frozen", "--no-default-groups", "--group", "training", "--no-emit-project", "--format", "pylock.toml", "-o", "pylock.training.toml"]
RUN ["/uv", "export", "--frozen", "--no-default-groups", "--group", "training", "--group", "optimize", "--no-emit-project", "--format", "pylock.toml", "-o", "pylock.optimize.toml"]

FROM ubuntu:noble-20260930.1 AS training-base

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /uvx /bin/

# ultralytics' transitive opencv-python needs the GUI/GL runtime libs; ca-certificates for HTTPS downloads
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgl1 libglib2.0-0 libxcb1 \
    && rm -rf /var/lib/apt/lists/*

# The cache dir pins uv to the build's cache mount; it would follow HOME otherwise.
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_CACHE_DIR=/root/.cache/uv

# CDI ignores it; a legacy-hook host mounts only the driver libs it names
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN mkdir -m 1777 /home/app
ENV HOME=/home/app USER=app

WORKDIR /app
# ultralytics' runs dir is cwd-relative, and the cwd stays /app for the relative configs/ paths
RUN mkdir -m 1777 /app/runs

COPY .python-version ./
COPY --from=lock /lock/pylock.training.toml ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv && uv pip sync pylock.training.toml


FROM training-base AS train

COPY pyproject.toml uv.lock README.md ./
COPY src/ src/
COPY configs/ configs/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --group training

ENV PATH="/app/.venv/bin:$PATH"


FROM training-base AS optimize

# The export toolchain on top of the shared gpu venv.
COPY --from=lock /lock/pylock.optimize.toml ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip sync pylock.optimize.toml

COPY pyproject.toml uv.lock README.md ./
COPY src/ src/
COPY configs/ configs/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --group training --group optimize

# ORT's CUDA EP dlopens the venv's CUDA libs; register them for any process, torch-imported or not
RUN ls -d /app/.venv/lib/python*/site-packages/nvidia/*/lib > /etc/ld.so.conf.d/venv-nvidia.conf && ldconfig

ENV PATH="/app/.venv/bin:$PATH"
