# Local-dev values for the Airflow CT stack.
# These are NOT secrets (throwaway local credentials/keys); in cloud they come from a secret manager.

# Airflow metadata DB (Postgres; in-network only, no host port).
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow api-server (UI + REST + task-execution API).
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# Throwaway local keys: JWT signs api tokens, Fernet encrypts connections/variables at rest.
AIRFLOW_JWT_SECRET=local-dev-jwt-secret
AIRFLOW_FERNET_KEY=5tXIPB7bBoN-9Rqen7L0r-mqcaIXiOE09xU4av1GfOw=

# In-container user (official-image convention).
AIRFLOW_UID=50000

# The GPU train/eval image the DAG launches (built by `make train-image`).
TRAIN_IMAGE=mlops-cv-train:0.1.0

# The MLflow stack's server port (the tracking URI inside the network is http://mlflow:<port>).
MLFLOW_PORT=5000
